{
  "name": "veil-extension",
  "version": "0.0.1",
  "description": "Veil Chrome Extension - 揭开网页面纱",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wxt": "^0.20.26"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^3.2.0",
    "d3": "^7.9.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
